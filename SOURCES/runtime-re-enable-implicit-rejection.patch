+++ b/src/runtime/src/native/libs/System.Security.Cryptography.Native/opensslshim.h
@@ -450,10 +450,8 @@ extern bool g_libSslUses32BitTime;
     REQUIRED_FUNCTION(ERR_peek_error) \
